# ═══════════════════════════════════════════════════
# Golf Charity Subscription & Prize Platform — Environment Variables
# Copy this file to .env.local for local development.
# ═══════════════════════════════════════════════════

# ── 1. Supabase Database & Auth (Required) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-private-key

# ── 2. Stripe Payments & Billing Engine (Required) ──
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_MONTHLY_PRICE_ID=price_1...
STRIPE_YEARLY_PRICE_ID=price_1...

# ── 3. Application Domain & URLs (Required in Production) ──
# In production, set to your canonical domain (e.g. https://golfforgood.org)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 4. Transactional Email via Resend (Optional in Dev, Recommended for Prod) ──
RESEND_API_KEY=re_...
# Set to your verified sender domain (e.g. Golf Platform <notifications@golfforgood.org>)
EMAIL_FROM=Golf Platform <onboarding@resend.dev>

# ── 5. Environment Mode ──
NODE_ENV=development
