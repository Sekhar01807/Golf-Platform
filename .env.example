# ═══════════════════════════════════════════════════════════════════
# Golf Charity Subscription & Prize Platform — Environment Template
# Copy this file to .env.local for local development.
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# SECTION A: PUBLIC VARIABLES (Browser Accessible via NEXT_PUBLIC_*)
# ───────────────────────────────────────────────────────────────────

# Supabase Project Canonical API Gateway URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (RLS-enforced browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Stripe Client Publishable Key (Client-side checkout elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Canonical Application URL (e.g. http://localhost:3000 in dev, https://golfforgood.org in prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────────────
# SECTION B: PRIVATE / SECRET VARIABLES (Server-Only — NEVER Expose to Client)
# ───────────────────────────────────────────────────────────────────

# Supabase Elevated Service Role Key (Bypasses RLS for secure webhooks and admin operations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe Secret API Key
STRIPE_SECRET_KEY=sk_test_51...

# Stripe Webhook Signing Secret (Validates authentic Stripe event signatures)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Subscription Price or Product IDs (price_... or prod_...)
STRIPE_MONTHLY_PRICE_ID=price_1...
STRIPE_YEARLY_PRICE_ID=price_1...

# Resend Transactional Email API Key (Optional in dev mock mode; required in prod)
RESEND_API_KEY=re_...

# Verified Sender Email Address (e.g., Golf Platform <notifications@golfforgood.org>)
EMAIL_FROM=Golf Platform <onboarding@resend.dev>

# Runtime Environment Mode (development | test | production)
NODE_ENV=development
