# ── Dependencies ──
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment & Secrets ──
# Strictly block all environment variables and secret files
.env
.env.*
.env*.local
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env
*.env.*
*.env.local

# Allow ONLY the non-secret example template to be tracked
!.env.example

# ── Next.js & Build Artifacts ──
/.next/
/out/
/build
/dist
.turbo/
.cache/

# ── Testing & Coverage ──
/coverage
/test-results/
/playwright-report/

# ── TypeScript & Runtime ──
*.tsbuildinfo
next-env.d.ts

# ── Vercel & Hosting ──
.vercel

# ── Logs & Debug ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS & System Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDEs & Local Agent Configs ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.gemini/
.system_generated/

# ── Certificates & Keys ──
*.pem
*.key
*.cert
*.crt
